---
import { SITE } from '@/config';

interface Props {
  date: Date;
  prefix?: string;
}
const { date, prefix } = Astro.props;

const text = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: SITE.timezone,
}).format(date);
---

<time datetime={date.toISOString()} class="font-mono text-[0.78rem] tracking-wide text-[var(--color-faint)]">
  {prefix}{text}
</time>
