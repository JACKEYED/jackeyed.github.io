---
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import FormattedDate from '@/components/FormattedDate.astro';
import portrait from '@/assets/portrait.jpeg';
import { SITE, SOCIALS, CV } from '@/config';
import { FOCUS, EXPERIENCE, BIO } from '@/data/resume';
import { getFeaturedProjects, getProjects, getNotes } from '@/lib/content';

const featured = await getFeaturedProjects();
const projects = featured.length ? featured : (await getProjects()).slice(0, 3);
const notes = (await getNotes()).slice(0, 3);

const facts = [
  { k: '现在', v: '复旦大学 · 计算与智能创新学院' },
  { k: '本科', v: '西电软件工程 · rank 1/88' },
  { k: '方向', v: 'LLM · RL · AI 工程' },
];
---

<Base>
  <!-- ——— Hero ——— -->
  <section class="relative overflow-hidden border-b border-[var(--color-line)]">
    <div class="dot-field pointer-events-none absolute inset-x-0 top-0 h-[440px]"></div>
    <div class="relative mx-auto max-w-5xl px-[var(--gutter)] pb-16 pt-16 sm:pt-24">
      <p class="eyebrow mb-8">{SITE.nameEn} · 研究主页</p>

      <div class="grid gap-8 sm:grid-cols-[8.5rem_1fr] sm:gap-10 lg:grid-cols-[10rem_1fr]">
        <Image
          src={portrait}
          alt={SITE.name}
          width={360}
          densities={[1.5, 2]}
          class="h-44 w-[8.5rem] shrink-0 rounded-xl border border-[var(--color-line)] object-cover object-top shadow-[var(--shadow-card)] sm:h-48 sm:w-40 lg:h-56 lg:w-full"
        />

        <div>
          <h1 class="font-serif text-4xl leading-[1.08] sm:text-5xl lg:text-[3.4rem]">
            {SITE.name}
            <span class="ml-3 align-middle font-sans text-xl font-normal text-[var(--color-faint)] lg:text-2xl">
              {SITE.nameEn}
            </span>
          </h1>

          <p class="mt-5 max-w-2xl font-serif text-xl italic leading-snug text-[var(--color-ink-soft)] sm:text-2xl">
            构建能够学习、推理与行动的智能系统。
          </p>

          {
            BIO.map((para, i) => (
              <p
                class:list={[
                  'mt-4 max-w-2xl leading-relaxed',
                  i === 0
                    ? 'text-[0.98rem] text-[var(--color-ink-soft)]'
                    : 'text-[0.98rem] text-[var(--color-muted)]',
                ]}
              >
                {para}
              </p>
            ))
          }

          <div class="mt-7 flex flex-wrap items-center gap-3">
            <a
              href="/research"
              class="rounded-md bg-[var(--color-ink)] px-5 py-2.5 text-sm text-[var(--color-paper)] transition-opacity hover:opacity-90"
              >查看研究</a
            >
            <a
              href={CV.href}
              class="rounded-md border border-[var(--color-line-strong)] px-5 py-2.5 text-sm text-[var(--color-ink)] transition-colors hover:border-[var(--color-ink)]"
              >下载简历 (PDF)</a
            >
            {
              SOCIALS.map((s) => (
                <a
                  href={s.href}
                  target={s.href.startsWith('http') ? '_blank' : undefined}
                  rel={s.href.startsWith('http') ? 'me noopener' : undefined}
                  class="link-underline px-1 py-2.5 font-mono text-xs text-[var(--color-muted)]"
                >
                  {s.label}
                </a>
              ))
            }
          </div>
        </div>
      </div>

      <dl class="mt-12 grid grid-cols-1 gap-px overflow-hidden rounded-lg border border-[var(--color-line)] bg-[var(--color-line)] sm:grid-cols-3">
        {
          facts.map((f) => (
            <div class="bg-[var(--color-paper)] p-4">
              <dt class="font-mono text-[0.68rem] uppercase tracking-[0.12em] text-[var(--color-faint)]">
                {f.k}
              </dt>
              <dd class="mt-1 text-sm text-[var(--color-ink)]">{f.v}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- ——— 研究方向 ——— -->
  <section class="mx-auto max-w-5xl px-[var(--gutter)] py-14 sm:py-16">
    <SectionHeading index="01" label="Focus" title="研究方向" />
    <div class="grid gap-px overflow-hidden rounded-lg border border-[var(--color-line)] bg-[var(--color-line)] sm:grid-cols-2">
      {
        FOCUS.map((f, i) => (
          <div class="bg-[var(--color-paper)] p-6 sm:p-8" data-reveal>
            <span class="font-mono text-xs text-[var(--color-faint)]">0{i + 1}</span>
            <h3 class="mt-3 font-serif text-lg text-[var(--color-ink)]">{f.title}</h3>
            <p class="mt-2 text-[0.92rem] leading-relaxed text-[var(--color-muted)]">{f.desc}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ——— 精选研究 ——— -->
  <section class="mx-auto max-w-5xl px-[var(--gutter)] py-14 sm:py-16 border-t border-[var(--color-line)]">
    <SectionHeading index="02" label="Research" title="精选研究" href="/research" cta="全部研究" />
    <div>
      {projects.map((project, i) => <ProjectCard project={project} index={i} />)}
    </div>
  </section>

  <!-- ——— 经历 ——— -->
  <section class="mx-auto max-w-5xl px-[var(--gutter)] py-14 sm:py-16 border-t border-[var(--color-line)]">
    <SectionHeading index="03" label="Experience" title="经历" href="/about" cta="完整履历" />
    <div class="space-y-12">
      {
        EXPERIENCE.map((job) => (
          <article data-reveal class="grid gap-x-10 gap-y-3 sm:grid-cols-[10rem_1fr]">
            <div class="font-mono text-xs text-[var(--color-faint)] sm:pt-1">{job.period}</div>
            <div>
              <h3 class="font-serif text-xl text-[var(--color-ink)]">
                {job.org}
                <span class="ml-2 align-middle font-sans text-sm font-normal text-[var(--color-muted)]">
                  {job.role}
                </span>
              </h3>
              {job.product && (
                <p class="mt-1 font-mono text-xs text-[var(--color-faint)]">产品 · {job.product}</p>
              )}
              <p class="mt-3 max-w-2xl text-[0.95rem] leading-relaxed text-[var(--color-muted)]">
                {job.summary}
              </p>
              <ul class="mt-4 space-y-2">
                {job.points.map((p) => (
                  <li class="relative max-w-2xl pl-4 text-[0.92rem] leading-relaxed text-[var(--color-ink-soft)]">
                    <span class="absolute left-0 top-[0.62em] size-[5px] rotate-45 bg-[var(--color-accent)]" />
                    {p}
                  </li>
                ))}
              </ul>
              {job.href && (
                <a href={job.href} class="link-underline mt-5 inline-block font-mono text-xs text-[var(--color-accent)]">
                  查看项目详情 →
                </a>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <!-- ——— 笔记 ——— -->
  {
    notes.length > 0 && (
      <section class="mx-auto max-w-5xl px-[var(--gutter)] py-14 sm:py-16 border-t border-[var(--color-line)]">
        <SectionHeading index="04" label="Writing" title="研究笔记" href="/notes" cta="全部笔记" />
        <ul>
          {notes.map((note) => (
            <li data-reveal>
              <a
                href={`/notes/${note.id}`}
                class="group flex flex-col gap-1 border-t border-[var(--color-line)] py-6 first:border-t-0 sm:flex-row sm:items-baseline sm:justify-between sm:gap-8"
              >
                <span class="font-serif text-lg text-[var(--color-ink)] transition-colors group-hover:text-[var(--color-accent)]">
                  {note.data.title}
                </span>
                <FormattedDate date={note.data.date} />
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <!-- ——— 联系 ——— -->
  <section class="mx-auto max-w-5xl px-[var(--gutter)] py-14 sm:py-16">
    <div class="rounded-xl border border-[var(--color-line)] bg-[var(--color-surface)] p-8 shadow-[var(--shadow-card)] sm:p-12" data-reveal>
      <p class="eyebrow mb-4">Contact</p>
      <h2 class="max-w-xl font-serif text-2xl sm:text-3xl">
        对大模型、强化学习或智能体系统的合作与讨论感兴趣，欢迎来信。
      </h2>
      <div class="mt-8 flex flex-wrap gap-x-8 gap-y-3">
        {
          SOCIALS.map((s) => (
            <a href={s.href} class="link-underline text-sm" target={s.href.startsWith('http') ? '_blank' : undefined}>
              <span class="text-[var(--color-muted)]">{s.label} — </span>
              <span class="text-[var(--color-ink)]">{s.handle}</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Base>
