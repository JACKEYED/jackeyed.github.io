---
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import portrait from '@/assets/portrait.jpeg';
import { SITE, SOCIALS, CV } from '@/config';
import { BIO, EXPERIENCE, EDUCATION, SKILLS, AWARDS } from '@/data/resume';
---

<Base title="关于" description={SITE.description}>
  <section class="mx-auto max-w-3xl px-[var(--gutter)] pt-20 sm:pt-28">
    <p class="eyebrow mb-6">About</p>

    <div class="flex flex-col gap-8 sm:flex-row sm:items-start sm:gap-10">
      <Image
        src={portrait}
        alt="高博远"
        width={320}
        densities={[1.5, 2]}
        class="h-40 w-32 shrink-0 rounded-lg border border-[var(--color-line)] object-cover object-top"
      />
      <div>
        <h1 class="font-serif text-4xl leading-tight sm:text-5xl">
          {SITE.name}
          <span class="ml-2 align-middle font-sans text-xl font-normal text-[var(--color-faint)]">
            {SITE.nameEn}
          </span>
        </h1>
        {
          BIO.map((para, i) => (
            <p
              class:list={[
                'mt-4 text-lg leading-relaxed first:mt-5',
                i === 0 ? 'text-[var(--color-ink-soft)]' : 'text-[var(--color-muted)]',
              ]}
            >
              {para}
            </p>
          ))
        }

        <div class="mt-7 flex flex-wrap gap-x-6 gap-y-2">
          {
            SOCIALS.map((s) => (
              <a
                href={s.href}
                target={s.href.startsWith('http') ? '_blank' : undefined}
                rel={s.href.startsWith('http') ? 'me noopener' : undefined}
                class="link-underline text-sm"
              >
                <span class="text-[var(--color-muted)]">{s.label} — </span>
                <span class="text-[var(--color-ink)]">{s.handle}</span>
              </a>
            ))
          }
          <a href={CV.href} class="link-underline text-sm text-[var(--color-accent)]">
            简历 PDF ↓ <span class="text-[var(--color-faint)]">（{CV.updated}）</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 教育 -->
  <section class="mx-auto max-w-3xl px-[var(--gutter)] py-14">
    <div class="rule-label mb-8"><span class="eyebrow">Education</span></div>
    <div class="space-y-10">
    {
      EDUCATION.map((e) => (
        <div class="grid gap-x-8 gap-y-3 sm:grid-cols-[9rem_1fr]">
          <div class="font-mono text-xs text-[var(--color-faint)] sm:pt-1">{e.period}</div>
          <div>
            <h3 class="font-serif text-xl text-[var(--color-ink)]">
              {e.school}
              {e.note && (
                <span class="ml-2 rounded border border-[var(--color-line-strong)] px-2 py-0.5 align-middle font-sans text-[0.7rem] font-normal text-[var(--color-muted)]">
                  {e.note}
                </span>
              )}
            </h3>
            <p class="mt-1 text-sm text-[var(--color-muted)]">{e.degree}</p>
            <ul class="mt-4 space-y-2">
              {e.highlights.map((h) => (
                <li class="relative pl-4 text-[0.92rem] leading-relaxed text-[var(--color-ink-soft)]">
                  <span class="absolute left-0 top-[0.62em] size-[5px] rotate-45 bg-[var(--color-accent)]" />
                  {h}
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))
    }
    </div>
  </section>

  <!-- 经历 -->
  <section class="mx-auto max-w-3xl px-[var(--gutter)] py-14">
    <div class="rule-label mb-8"><span class="eyebrow">Experience</span></div>
    <div class="space-y-12">
      {
        EXPERIENCE.map((job) => (
          <article class="grid gap-x-8 gap-y-3 sm:grid-cols-[9rem_1fr]">
            <div class="font-mono text-xs text-[var(--color-faint)] sm:pt-1">{job.period}</div>
            <div>
              <h3 class="font-serif text-xl text-[var(--color-ink)]">
                {job.org}
                <span class="ml-2 align-middle font-sans text-sm font-normal text-[var(--color-muted)]">{job.role}</span>
              </h3>
              {job.product && <p class="mt-1 font-mono text-xs text-[var(--color-faint)]">产品 · {job.product}</p>}
              <p class="mt-3 text-[0.95rem] leading-relaxed text-[var(--color-muted)]">{job.summary}</p>
              <ul class="mt-4 space-y-2">
                {job.points.map((p) => (
                  <li class="relative pl-4 text-[0.92rem] leading-relaxed text-[var(--color-ink-soft)]">
                    <span class="absolute left-0 top-[0.62em] size-[5px] rotate-45 bg-[var(--color-accent)]" />
                    {p}
                  </li>
                ))}
              </ul>
              {job.stack && (
                <p class="mt-4 font-mono text-xs text-[var(--color-faint)]">{job.stack.join('  ·  ')}</p>
              )}
              {job.href && (
                <a href={job.href} class="link-underline mt-4 inline-block font-mono text-xs text-[var(--color-accent)]">
                  查看项目详情 →
                </a>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <!-- 技能 -->
  <section class="mx-auto max-w-3xl px-[var(--gutter)] py-14">
    <div class="rule-label mb-8"><span class="eyebrow">Stack</span></div>
    <dl class="space-y-6">
      {
        SKILLS.map((s) => (
          <div class="grid gap-x-8 gap-y-2 sm:grid-cols-[9rem_1fr]">
            <dt class="font-mono text-xs text-[var(--color-faint)] sm:pt-1">{s.group}</dt>
            <dd class="flex flex-wrap gap-2">
              {s.items.map((i) => (
                <span class="rounded-md border border-[var(--color-line)] bg-[var(--color-surface)] px-2.5 py-1 text-[0.82rem] text-[var(--color-ink-soft)]">
                  {i}
                </span>
              ))}
            </dd>
          </div>
        ))
      }
    </dl>
  </section>

  <!-- 荣誉 -->
  <section class="mx-auto max-w-3xl px-[var(--gutter)] py-14">
    <div class="rule-label mb-8"><span class="eyebrow">Selected Awards</span></div>
    <ul class="space-y-3">
      {
        AWARDS.map((a) => (
          <li class="relative pl-4 text-[0.95rem] leading-relaxed text-[var(--color-ink-soft)]">
            <span class="absolute left-0 top-[0.62em] size-[5px] rotate-45 bg-[var(--color-accent)]" />
            {a}
          </li>
        ))
      }
    </ul>
  </section>
</Base>
