---
import { render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import FormattedDate from '@/components/FormattedDate.astro';
import { getNotes } from '@/lib/content';

export async function getStaticPaths() {
  const notes = await getNotes();
  return notes.map((note) => ({ params: { slug: note.id }, props: { note } }));
}

const { note } = Astro.props;
const { data } = note;
const { Content, headings } = await render(note);
const toc = headings.filter((h) => h.depth === 2);
---

<Base title={data.title} description={data.description} type="article" publishedTime={data.date}>
  <article class="mx-auto max-w-3xl px-[var(--gutter)] pt-20 sm:pt-28">
    <a href="/notes" class="link-underline font-mono text-xs text-[var(--color-muted)]">← 笔记</a>

    <header class="mt-8 border-b border-[var(--color-line)] pb-10">
      <div class="flex flex-wrap items-center gap-3">
        <FormattedDate date={data.date} />
        {data.updated && <FormattedDate date={data.updated} prefix="更新于 " />}
        {
          data.tags.map((t) => (
            <span class="font-mono text-[0.66rem] uppercase tracking-[0.12em] text-[var(--color-faint)]">{t}</span>
          ))
        }
      </div>
      <h1 class="mt-4 font-serif text-3xl leading-tight sm:text-[2.4rem]">{data.title}</h1>
      <p class="mt-4 text-lg leading-relaxed text-[var(--color-muted)]">{data.description}</p>
    </header>

    {
      toc.length > 2 && (
        <nav class="my-10 rounded-lg border border-[var(--color-line)] bg-[var(--color-surface)] p-5">
          <p class="eyebrow mb-3">目录</p>
          <ol class="space-y-1.5">
            {toc.map((h) => (
              <li>
                <a href={`#${h.slug}`} class="link-underline text-sm text-[var(--color-muted)]">
                  {h.text}
                </a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }

    <div class="prose py-10">
      <Content />
    </div>
  </article>
</Base>
